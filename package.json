{
  "name": "gps-tools-frontend",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "rm dist/mockServiceWorker.js && rm -rf dist/mocks",
    "test": "vitest",
    "test:e2e": "npx playwright test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "check": "eslint . --report-unused-disable-directives --max-warnings 0 && prettier --check ./src && vitest --watch=false",
    "check:fix": "eslint . --fix && prettier --write ./src && vitest --watch=false",
    "preview": "vite preview",
    "upgrade": "ncu -u",
    "upgrade:patches": "ncu -u --target patch",
    "upgrade:minor": "ncu -u --target minor"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "dompurify": "^3.4.17",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "gpxparser": "^3.0.8",
    "hamburger-react": "^2.5.2",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^19.3.1",
    "react-dropzone": "^14.4.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-tooltip": "^5.30.1",
    "react-use": "^17.6.1",
    "sanitize-html": "^2.18.1",
    "uuid": "^13.0.2",
    "vite-plugin-package-version": "^1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-vite-plugin": "^1.167.47",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^5.7.50",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "msw": "^2.15.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.65.0",
    "@swc/core-linux-x64-gnu": "^1.16.20",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    "@semantic-release/github",
    "@semantic-release/npm",
    "@semantic-release/git"
  ],
  "release": {
    "branches": [
      "main"
    ],
    "prepare": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      {
        "path": "@semantic-release/git",
        "assets": [
          "package.json",
          "package-lock.json",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
